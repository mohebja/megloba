<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CELL_BROADCASTS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_CELL_BROADCAST" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".GlobalSmsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default SMS Handler Compose Intent Filters -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Default SMS Receiver -->
        <receiver
            android:name="com.global.sms.engine.receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Default MMS Receiver -->
        <receiver
            android:name="com.global.sms.engine.service.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <action android:name="android.provider.Telephony.MMS_RECEIVED" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Delivery & Sent Reports Receiver -->
        <receiver
            android:name="com.global.sms.engine.receiver.DeliveryReportReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.global.sms.engine.ACTION_SMS_SENT" />
                <action android:name="com.global.sms.engine.ACTION_SMS_DELIVERED" />
                <action android:name="com.global.sms.engine.ACTION_MMS_SENT" />
            </intent-filter>
        </receiver>

        <!-- Advanced Notification Action Receiver -->
        <receiver
            android:name="com.global.sms.engine.receiver.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.global.sms.engine.ACTION_NOTIF_REPLY" />
                <action android:name="com.global.sms.engine.ACTION_NOTIF_MARK_READ" />
                <action android:name="com.global.sms.engine.ACTION_NOTIF_ARCHIVE" />
                <action android:name="com.global.sms.engine.ACTION_NOTIF_DELETE" />
                <action android:name="com.global.sms.engine.ACTION_NOTIF_COPY_OTP" />
                <action android:name="com.global.sms.engine.ACTION_NOTIF_BLOCK" />
                <action android:name="com.global.sms.engine.ACTION_NOTIF_MUTE" />
            </intent-filter>
        </receiver>

        <!-- Service for Respond via Message -->
        <service
            android:name="com.global.sms.engine.service.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Disable default WorkManager initializer for on-demand initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
