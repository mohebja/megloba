<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude hardware-backed keys and keystore-dependent local data from legacy auto backup -->
    <exclude domain="file" path="security" />
    <exclude domain="file" path="backups" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="global_sms_secure_prefs.xml" />
</full-backup-content>
