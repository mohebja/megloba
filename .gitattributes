# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary files - do not alter line endings or convert
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.dex binary
*.aar binary
*.apk binary
*.aab binary
*.so binary

# Shell scripts must strictly use LF
gradlew text eol=lf
*.sh text eol=lf
